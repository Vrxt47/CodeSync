# ==============================================================================
# CodeSync - Environment Variables Configuration
# Copy this file to .env before starting services in development
# ==============================================================================

# General
NODE_ENV=development

# Web Frontend (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234

# Backend API (Express.js)
PORT=4000
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Collaboration Server (Hocuspocus / Yjs)
COLLAB_PORT=1234
COLLAB_HOST=0.0.0.0

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codesync?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codesync
POSTGRES_PORT=5432

# In-Memory Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
