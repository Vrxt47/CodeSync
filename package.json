{
  "name": "codesync-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"web,api,collab\" -c \"blue,green,magenta\" \"pnpm --filter @codesync/web dev\" \"pnpm --filter @codesync/api dev\" \"pnpm --filter @codesync/collaboration dev\"",
    "dev:web": "pnpm --filter @codesync/web dev",
    "dev:api": "pnpm --filter @codesync/api dev",
    "dev:collab": "pnpm --filter @codesync/collaboration dev",
    "build": "pnpm --filter @codesync/shared build && pnpm --filter @codesync/api build && pnpm --filter @codesync/collaboration build && pnpm --filter @codesync/web build",
    "prepare": "node scripts/link-env.js",
    "lint": "eslint .",
    "test": "pnpm test:db && pnpm test:backend && pnpm test:auth && pnpm test:concurrency && pnpm test:workspaces && pnpm test:files && pnpm test:files:concurrency && pnpm test:entry && pnpm test:editor && pnpm test:completions && pnpm test:chunk8 && pnpm test:file:concurrency",
    "test:db": "node scripts/run-test.js scripts/test-database.ts",
    "test:backend": "node scripts/run-test.js scripts/test-backend.ts",
    "test:auth": "node scripts/run-test.js scripts/test-auth.ts",
    "test:concurrency": "node scripts/run-test.js scripts/test-auth-concurrency.ts",
    "test:workspaces": "node scripts/run-test.js scripts/test-workspaces.ts",
    "test:files": "node scripts/run-test.js scripts/test-files.ts",
    "test:files:concurrency": "node scripts/run-test.js scripts/test-files-concurrency.ts",
    "test:entry": "node scripts/run-test.js scripts/test-entry-flow.ts",
    "test:editor": "node scripts/run-test.js scripts/test-editor-full.ts",
    "test:completions": "node scripts/run-test.js scripts/test-completion-providers.ts",
    "test:chunk8": "node scripts/run-test.js scripts/test-chunk8.ts",
    "test:file:concurrency": "node scripts/run-test.js scripts/test-file-concurrency-live.ts",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "prisma": "pnpm --filter @codesync/database prisma",
    "studio": "pnpm db:studio",
    "db:generate": "pnpm --filter @codesync/database db:generate",
    "db:push": "pnpm --filter @codesync/database db:push",
    "db:migrate": "pnpm --filter @codesync/database db:migrate",
    "db:deploy": "pnpm --filter @codesync/database db:deploy",
    "db:test:deploy": "node scripts/prisma-test.js migrate deploy",
    "db:test:status": "node scripts/prisma-test.js migrate status",
    "db:test:setup": "node scripts/run-test.js scripts/setup-test-db.ts",
    "db:dev:audit": "node packages/database/node_modules/tsx/dist/cli.mjs scripts/cleanup-dev-db.ts",
    "db:seed": "pnpm --filter @codesync/database db:seed",
    "db:studio": "pnpm --filter @codesync/database db:studio",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@codesync/config-eslint": "workspace:*",
    "@codesync/config-prettier": "workspace:*",
    "@codesync/config-typescript": "workspace:*",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
